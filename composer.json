{
    "name": "erasemc/hub",
    "description": "Hub system for the Erase Network (PocketMine-MP / Dummy).",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "libs/FormAPI",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "jojoe77777/form-api": "^1.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
